{
  "name": "molecular-motion-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @molecular-motion/demo",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check": "npm run typecheck && npm test && npm run build",
    "schema": "UPDATE_SCHEMA=1 vitest run packages/core/test/schema.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "axe-core": "^4.13.0",
    "happy-dom": "^20.14.5",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "license": "MIT"
}
