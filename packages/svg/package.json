{
  "name": "@molecular-motion/svg",
  "version": "0.1.1",
  "description": "Accessible SVG scene builder for Molecular Motion.",
  "keywords": [
    "biology",
    "molecular-biology",
    "visualization",
    "svg",
    "diagram"
  ],
  "homepage": "https://molecular-motion.alvaroesteban.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaroestebanperez/molecular-motion.git",
    "directory": "packages/svg"
  },
  "bugs": "https://github.com/alvaroestebanperez/molecular-motion/issues",
  "author": "Álvaro Esteban",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@molecular-motion/core": "^0.1.1"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
