{
  "name": "@molecular-motion/svg",
  "version": "0.3.0",
  "description": "SVG renderer of Molecular Motion: draws proteins, DNA, RNA, membranes and molecular interactions as accessible SVG diagrams of a biological mechanism, with or without a browser.",
  "keywords": [
    "biology",
    "visualization",
    "molecular-biology",
    "molecular-visualization",
    "biological-visualization",
    "scientific-visualization",
    "interactive-visualization",
    "cell-biology",
    "bioinformatics",
    "svg",
    "dna",
    "rna",
    "protein",
    "typescript",
    "diagram",
    "figure"
  ],
  "homepage": "https://molecular-motion.alvaroesteban.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaroestebanperez/molecular-motion.git",
    "directory": "packages/svg"
  },
  "bugs": "https://github.com/alvaroestebanperez/molecular-motion/issues",
  "author": "Álvaro Esteban",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@molecular-motion/core": "^0.3.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
