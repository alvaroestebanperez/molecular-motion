{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molecular-motion.alvaroesteban.dev/schema/v1.json",
  "title": "Molecular Motion mechanism",
  "type": "object",
  "required": ["schemaVersion", "mechanism", "actors", "steps"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "mechanism": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actor" }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "point": {
      "type": "object",
      "required": ["x", "y"],
      "properties": { "x": { "type": "number" }, "y": { "type": "number" } },
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "required": ["id"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string" },
        "label": { "type": "string" },
        "position": { "oneOf": [{ "enum": ["start", "center", "end"] }, { "$ref": "#/$defs/point" }] }
      },
      "additionalProperties": false
    },
    "actor": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["dna", "rna", "protein", "molecule", "complex"] },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "color": { "type": "string" },
        "position": { "$ref": "#/$defs/point" },
        "sites": { "type": "array", "items": { "$ref": "#/$defs/site" } },
        "initiallyVisible": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "required": ["id", "title", "actions"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "duration": { "type": "number", "minimum": 0 },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } }
      },
      "additionalProperties": false
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/lesionAction" },
        { "$ref": "#/$defs/actorTargetAction" },
        { "$ref": "#/$defs/actorAction" },
        { "$ref": "#/$defs/polymerizeAction" },
        { "$ref": "#/$defs/modifyAction" }
      ]
    },
    "lesionAction": {
      "type": "object",
      "required": ["type", "target"],
      "properties": {
        "type": { "enum": ["create-lesion", "repair-lesion"] },
        "target": { "type": "string" },
        "lesion": { "enum": ["single-strand-break", "double-strand-break", "base-damage", "adduct"] },
        "duration": { "type": "number" }
      },
      "additionalProperties": false
    },
    "actorTargetAction": {
      "type": "object",
      "required": ["type", "actor", "target"],
      "properties": {
        "type": { "enum": ["bind", "recruit"] },
        "actor": { "$ref": "#/$defs/id" },
        "target": { "type": "string" },
        "duration": { "type": "number" }
      },
      "additionalProperties": false
    },
    "actorAction": {
      "type": "object",
      "required": ["type", "actor"],
      "properties": {
        "type": { "enum": ["unbind", "show", "hide"] },
        "actor": { "$ref": "#/$defs/id" },
        "duration": { "type": "number" }
      },
      "additionalProperties": false
    },
    "polymerizeAction": {
      "type": "object",
      "required": ["type", "actor", "product"],
      "properties": {
        "type": { "const": "polymerize" },
        "actor": { "$ref": "#/$defs/id" },
        "product": { "type": "string" },
        "length": { "type": "integer", "minimum": 1 },
        "duration": { "type": "number" }
      },
      "additionalProperties": false
    },
    "modifyAction": {
      "type": "object",
      "required": ["type", "actor", "modification"],
      "properties": {
        "type": { "const": "modify" },
        "actor": { "$ref": "#/$defs/id" },
        "modification": { "type": "string" },
        "label": { "type": "string" },
        "duration": { "type": "number" }
      },
      "additionalProperties": false
    }
  }
}
