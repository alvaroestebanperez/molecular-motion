{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molecular-motion.dev/schema/v3.json",
  "title": "Molecular Motion mechanism",
  "type": "object",
  "required": [
    "schemaVersion",
    "mechanism",
    "actors",
    "steps"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "mechanism": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "references": {
          "$ref": "#/$defs/referenceIds"
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "compartments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/compartment"
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/actor"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "referenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "pmid"
          ]
        },
        {
          "required": [
            "doi"
          ]
        },
        {
          "required": [
            "reactome"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "citation": {
          "type": "string",
          "minLength": 1,
          "description": "Human-readable short citation, e.g. \"Ray Chaudhuri & Nussenzweig (2017) Nat Rev Mol Cell Biol\"."
        },
        "pmid": {
          "type": "string",
          "pattern": "^\\d{1,9}$"
        },
        "doi": {
          "type": "string",
          "pattern": "^10\\.\\d{4,9}/\\S+$"
        },
        "reactome": {
          "type": "string",
          "pattern": "^R-[A-Z]{3}-\\d+(\\.\\d+)?$"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "compartment": {
      "oneOf": [
        {
          "type": "string",
          "description": "A standard compartment id."
        },
        {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "enum": [
                "extracellular",
                "membrane",
                "cytoplasm",
                "nucleus",
                "er",
                "golgi",
                "mitochondrion",
                "endosome",
                "generic"
              ]
            },
            "label": {
              "type": "string"
            },
            "parent": {
              "$ref": "#/$defs/id"
            }
          }
        }
      ]
    },
    "site": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "at": {
          "type": "integer",
          "minimum": 0,
          "description": "Nucleic acids: interbase coordinate, 0 … length. A nucleotide-level site at n is the nucleotide [n, n + 1)."
        },
        "span": {
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "integer",
              "minimum": 1
            }
          ],
          "minItems": 2,
          "maxItems": 2,
          "description": "Nucleic acids: interbase interval [from, to)."
        },
        "strand": {
          "enum": [
            "top",
            "bottom",
            "both"
          ],
          "description": "Nucleic acids: strand the site lies on; top runs 5′→3′ with increasing coordinate."
        },
        "position": {
          "$ref": "#/$defs/point",
          "description": "Layout override only; never a coordinate."
        }
      },
      "not": {
        "anyOf": [
          {
            "required": [
              "at",
              "span"
            ]
          },
          {
            "required": [
              "at",
              "position"
            ]
          },
          {
            "required": [
              "span",
              "position"
            ]
          }
        ]
      }
    },
    "nucleic": {
      "type": "object",
      "additionalProperties": false,
      "description": "dna/rna actors only: biological geometry (RFC 0004).",
      "properties": {
        "length": {
          "type": "integer",
          "minimum": 1,
          "description": "Nucleotides or base pairs. Defaults to 100."
        },
        "form": {
          "enum": [
            "duplex",
            "single"
          ],
          "description": "Defaults to duplex for dna and single for rna."
        },
        "strands": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string"
                }
              }
            },
            "bottom": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "dna",
            "rna",
            "protein",
            "molecule",
            "complex"
          ]
        },
        "label": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "position": {
          "$ref": "#/$defs/point"
        },
        "sites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/site"
          }
        },
        "nucleic": {
          "$ref": "#/$defs/nucleic"
        },
        "compartment": {
          "$ref": "#/$defs/id"
        },
        "molecule": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "Molecule actors only: key of the small-molecule vocabulary naming its structure, e.g. atp or nad-plus."
        },
        "initial": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "present": {
              "type": "boolean"
            },
            "visible": {
              "type": "boolean"
            },
            "activity": {
              "enum": [
                "active",
                "inactive",
                "inhibited"
              ]
            }
          }
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "id",
        "title",
        "actions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "keyEvents": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "references": {
          "$ref": "#/$defs/referenceIds"
        },
        "duration": {
          "type": "number",
          "minimum": 0
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "node": {
      "oneOf": [
        {
          "$ref": "#/$defs/action"
        },
        {
          "type": "object",
          "required": [
            "sequence"
          ],
          "additionalProperties": false,
          "properties": {
            "sequence": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "parallel"
          ],
          "additionalProperties": false,
          "properties": {
            "parallel": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        {
          "type": "object",
          "description": "Associate an actor with another actor or one of its sites.",
          "required": [
            "type",
            "actor",
            "target"
          ],
          "properties": {
            "type": {
              "const": "bind"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "actor": {
              "$ref": "#/$defs/id"
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Release an actor from its binding partner.",
          "required": [
            "type",
            "actor"
          ],
          "properties": {
            "type": {
              "const": "unbind"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "actor": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Set visibility or activity of an actor, or the lesion state of a site.",
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "const": "set-state"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)?$"
            },
            "visible": {
              "type": "boolean"
            },
            "activity": {
              "enum": [
                "active",
                "inactive",
                "inhibited"
              ]
            },
            "lesion": {
              "enum": [
                "single-strand-break",
                "nick",
                "double-strand-break",
                "base-damage",
                "abasic-site",
                "adduct",
                "none"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Add or remove a covalent modification, chain, or filament on an actor.",
          "required": [
            "type",
            "actor",
            "kind"
          ],
          "properties": {
            "type": {
              "const": "modify"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "actor": {
              "$ref": "#/$defs/id"
            },
            "kind": {
              "type": "string",
              "minLength": 1,
              "description": "Open vocabulary, e.g. phosphorylation, ubiquitination."
            },
            "site": {
              "type": "string",
              "minLength": 1,
              "description": "Residue or region, e.g. Y1068."
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "description": "Chain or filament length."
            },
            "remove": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Move an actor to another compartment. Bindings are never changed.",
          "required": [
            "type",
            "actor",
            "to"
          ],
          "properties": {
            "type": {
              "const": "translocate"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "actor": {
              "$ref": "#/$defs/id"
            },
            "to": {
              "$ref": "#/$defs/id"
            },
            "includeBound": {
              "type": "boolean",
              "description": "Also move every actor bound to this one, directly or transitively, keeping their bindings."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Bring a declared product into existence (initial.present: false).",
          "required": [
            "type",
            "product"
          ],
          "properties": {
            "type": {
              "const": "synthesize"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "product": {
              "$ref": "#/$defs/id"
            },
            "compartment": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Remove an actor from existence and release everything bound to it.",
          "required": [
            "type",
            "actor"
          ],
          "properties": {
            "type": {
              "const": "degrade"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "actor": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Break the backbone of a nucleic acid at a site.",
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "const": "cleave"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
            },
            "lesion": {
              "enum": [
                "single-strand-break",
                "nick",
                "double-strand-break"
              ]
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Seal a backbone break at a site.",
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "const": "ligate"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Remove nucleotides 5′→3′ from every 5′ end at a strand break, leaving 3′ overhangs.",
          "required": [
            "type",
            "target",
            "length"
          ],
          "properties": {
            "type": {
              "const": "resect"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
              "description": "Site with a break and a point coordinate (at)."
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "description": "Nucleotides removed from each 5′ end."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Synthesise nucleotides 5′→3′ from a 3′ end at a site into a gap, copying the opposite strand.",
          "required": [
            "type",
            "target",
            "length"
          ],
          "properties": {
            "type": {
              "const": "extend"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
              "description": "Site with a point coordinate (at) where the 3′ end sits."
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "description": "Nucleotides added."
            },
            "strand": {
              "enum": [
                "top",
                "bottom"
              ],
              "description": "Strand to extend; needed only when both offer a 3′ end."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Separate both strands into an unpaired bubble around a site.",
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "const": "unwind"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
              "description": "Site with a coordinate; a span is the bubble itself."
            },
            "length": {
              "type": "integer",
              "minimum": 1,
              "description": "Bubble length, centred on a point site (at). Not used with a span."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Re-pair the unwound bubble at a site.",
          "required": [
            "type",
            "target"
          ],
          "properties": {
            "type": {
              "const": "anneal"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$",
              "description": "Site with a coordinate inside or at the edge of the bubble."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Bind an actor that is brought in by its target.",
          "required": [
            "type",
            "actor",
            "target"
          ],
          "properties": {
            "type": {
              "const": "recruit"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "actor": {
              "$ref": "#/$defs/id"
            },
            "target": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)?$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Show an actor without changing its biology.",
          "required": [
            "type",
            "actor"
          ],
          "properties": {
            "type": {
              "const": "show"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "actor": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Hide an actor without changing its biology.",
          "required": [
            "type",
            "actor"
          ],
          "properties": {
            "type": {
              "const": "hide"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "actor": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Mark an actor as active.",
          "required": [
            "type",
            "actor"
          ],
          "properties": {
            "type": {
              "const": "activate"
            },
            "duration": {
              "type": "integer",
              "minimum": 0,
              "description": "Duration in milliseconds (presentation only)."
            },
            "by": {
              "$ref": "#/$defs/id",
              "description": "Causal agent: enzyme, ligand, drug, or sensor."
            },
            "actor": {
              "$ref": "#/$defs/id"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "description": "Mark an actor as inactive.",
          "required": [
            "type",
            "actor"
          ],
          "properties": {
            "type": {
              "const": "inactivate"
            },
