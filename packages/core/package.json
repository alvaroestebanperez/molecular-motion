{
  "name": "@molecular-motion/core",
  "version": "0.3.0",
  "description": "Compiler and state engine of Molecular Motion, a TypeScript library for interactive and animated molecular biology visualizations in SVG. Mechanisms of proteins, DNA and RNA are written in YAML or JSON.",
  "keywords": [
    "biology",
    "visualization",
    "molecular-biology",
    "molecular-visualization",
    "biological-visualization",
    "scientific-visualization",
    "interactive-visualization",
    "cell-biology",
    "bioinformatics",
    "svg",
    "dna",
    "rna",
    "protein",
    "typescript",
    "yaml",
    "declarative"
  ],
  "homepage": "https://molecular-motion.alvaroesteban.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaroestebanperez/molecular-motion.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/alvaroestebanperez/molecular-motion/issues",
  "author": "Álvaro Esteban",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./yaml": {
      "types": "./dist/yaml.d.ts",
      "import": "./dist/yaml.js"
    }
  },
  "files": [
    "dist",
    "schema.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/yaml.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.8.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
