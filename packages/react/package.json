{
  "name": "@molecular-motion/react",
  "version": "0.3.0",
  "description": "React player of Molecular Motion: interactive, animated SVG visualizations of molecular biology mechanisms such as DNA repair, transcription and signalling.",
  "keywords": [
    "biology",
    "visualization",
    "molecular-biology",
    "molecular-visualization",
    "biological-visualization",
    "scientific-visualization",
    "interactive-visualization",
    "cell-biology",
    "bioinformatics",
    "svg",
    "dna",
    "rna",
    "protein",
    "typescript",
    "react",
    "animation"
  ],
  "homepage": "https://molecular-motion.alvaroesteban.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alvaroestebanperez/molecular-motion.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/alvaroestebanperez/molecular-motion/issues",
  "author": "Álvaro Esteban",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.tsx --format esm --dts --clean --external react",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@molecular-motion/core": "^0.3.0",
    "@molecular-motion/svg": "^0.3.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
